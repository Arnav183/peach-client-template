# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=your-secret-here-change-this

# Client business details — set these before deploying
BUSINESS_NAME=Luxe Threading Studio
OWNER_EMAIL=owner@business.com
OWNER_PASSWORD=ChangeMe123!
INDUSTRY=beauty

# ─── ACTIVE SERVICES ──────────────────────────────────────────────────────────
# Comma-separated list of service IDs the client has purchased.
# crm_dashboard is always included. Add any from the list below:
#   onboarding_setup, basic_website, custom_website, local_seo,
#   booking_calendar, appt_reminders, ai_phone_agent, ai_chat_widget,
#   auto_followup, review_management, email_sms_marketing,
#   social_templates, priority_support
ACTIVE_SERVICES=crm_dashboard,onboarding_setup,basic_website,booking_calendar

# ─── DEPLOYMENT ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── OPTIONAL INTEGRATIONS ────────────────────────────────────────────────────
# RESEND_API_KEY=re_...         # For email reminders / marketing
# TWILIO_SID=...                # For SMS reminders
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
# GOOGLE_MAPS_API_KEY=...       # For local SEO widget
